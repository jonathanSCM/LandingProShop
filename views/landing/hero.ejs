  <!-- ============================================================
       HERO
  ============================================================= -->
  <%# Datos que salen de los proyectos reales: si cambias un proyecto, cambia el conteo. %>
  <% var vivos = proyectos.filter(function (p) { return !p.oculto; }); %>
  <% var enProd = vivos.filter(function (p) { return p.estado === 'produccion'; }); %>
  <% var propios = vivos.filter(function (p) { return p.origen === 'propio'; }); %>
  <% function unir(a) { var n = a.map(function (p) { return p.nombre; }); return n.length < 2 ? n.join('') : n.slice(0, -1).join(', ') + ' y ' + n[n.length - 1]; } %>
  <section class="hero" id="inicio">
    <div class="shell">
      <div class="hero-main">
        <div class="hero-copy">
          <p class="tag">
            <span class="tag-dot" aria-hidden="true"></span>
            <span data-edit="hero.tag"><%- t('hero.tag', 'Software a medida para empresas que ya operan') %></span>
          </p>

          <h1 class="hero-title" data-edit="hero.titulo">
            <%- t('hero.titulo', 'Ordenamos lo que hoy<br />\n<em>frena a tu empresa</em>.') %>
          </h1>

          <p class="hero-lead" data-edit="hero.lead">
            <%- t('hero.lead', 'Pedidos por WhatsApp, citas dispersas, cotizaciones que se pierden, producción sin control. Diseñamos y desarrollamos <strong>el sistema que lo resuelve</strong>, empezando por el proceso que más necesitas mejorar.') %>
          </p>

          <div class="hero-cta">
            <a class="btn btn-solid btn-lg"<%- enlace('hero.cta1', '#contacto') %> data-edit="hero.cta1"><%- t('hero.cta1', 'Solicitar diagnóstico') %></a>
            <a class="btn btn-line btn-lg"<%- enlace('hero.cta2', '#proyectos') %> data-edit="hero.cta2"><%- t('hero.cta2', 'Ver proyectos') %></a>
            <p class="cta-note" data-edit="hero.nota"><%- t('hero.nota', 'La primera reunión es un diagnóstico de 20 minutos, sin costo.') %></p>
          </div>
        </div>

        <%- include('vitrina') %>
      </div>

      <dl class="specs">
        <div class="spec">
          <dt data-edit="spec1.et"><%- t('spec1.et', 'En producción') %></dt>
          <dd data-edit="spec1.valor"><%- t('spec1.valor', enProd.length + (enProd.length === 1 ? ' sistema' : ' sistemas')) %></dd>
          <p data-edit="spec1.nota"><%- t('spec1.nota', unir(enProd.slice(0, 5)) || 'Sistemas funcionando con su estado real.') %></p>
        </div>
        <div class="spec">
          <dt data-edit="spec2.et"><%- t('spec2.et', 'Productos propios') %></dt>
          <dd data-edit="spec2.valor"><%- t('spec2.valor', propios.length ? String(propios.length) : 'A medida') %></dd>
          <p data-edit="spec2.nota"><%- t('spec2.nota', propios.length ? unir(propios) + ', además de los desarrollos a medida.' : 'Desarrollo a medida, adaptando e integrando lo que ya usas.') %></p>
        </div>
        <div class="spec">
          <dt data-edit="spec3.et"><%- t('spec3.et', 'Credencial') %></dt>
          <dd data-edit="spec3.valor"><%- t('spec3.valor', 'Meta Tech Provider') %></dd>
          <p data-edit="spec3.nota"><%- t('spec3.nota', 'Integramos WhatsApp Business Platform con los procesos de tu empresa.') %></p>
        </div>
        <div class="spec">
          <dt data-edit="spec4.et"><%- t('spec4.et', 'Cómo empezamos') %></dt>
          <dd data-edit="spec4.valor"><%- t('spec4.valor', 'Diagnóstico sin costo') %></dd>
          <p data-edit="spec4.nota"><%- t('spec4.nota', 'Reunión de 20 minutos y, después, una demo en 48 horas.') %></p>
        </div>
      </dl>
    </div>

    <%- include('sistemas') %>
  </section>

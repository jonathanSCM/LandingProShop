          </ul>
        </div>
        <aside class="tech-meta">
          <span class="meta-badge" data-edit="tec.meta.nombre"><%- t('tec.meta.nombre', 'Meta Tech Provider') %></span>
          <p data-edit="tec.meta.texto"><%- t('tec.meta.texto', 'Integramos WhatsApp Business Platform para conectar las conversaciones con los procesos de tu empresa.') %></p>

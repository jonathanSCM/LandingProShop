            <li><span class="tech-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13 2L5 14h6l-1 8 8-12h-6z" /></svg></span><span data-edit="tec.i1"><%- t('tec.i1', 'Firebase') %></span></li>

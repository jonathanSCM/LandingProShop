<!DOCTYPE html>
<html lang="es"<%- htmlAttrs ? ' ' + htmlAttrs : '' %>>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="ProShop desarrolla software a medida para empresas que ya operan y necesitan mejorar procesos concretos: plataformas web, aplicaciones móviles, paneles de datos y agentes con inteligencia artificial." />
  <meta name="theme-color" content="#f4f3ef" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#131310" media="(prefers-color-scheme: dark)" />
  <title><%= title %></title>

  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="Software a medida para empresas que ya operan y necesitan mejorar procesos concretos." />
  <meta property="og:type" content="website" />

  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/landing.css" />
  <link rel="stylesheet" href="/css/landing-animado.css" />
  <% if (hayCustom || editando) { %><link rel="stylesheet" href="/css/paginas.css" /><% } %>
  <% if (fuenteUrl) { %><link rel="stylesheet" href="<%= fuenteUrl %>" /><% } %>
  <% if (editando || esAdmin) { %><link rel="stylesheet" href="/css/landing-editor.css" /><% } %>
  <% if (editando) { %><link rel="stylesheet" href="/css/biblioteca.css" /><% } %>
  <% if (disenoCss) { %><style id="disenoCss"><%- disenoCss %></style><% } %>

  <script>
    /* Aplica el tema elegido antes del primer pintado: sin esto la pagina
       asomaria en claro un instante antes de pasar a oscuro. Va aqui suelto
       y no en landing.js justamente porque ese se carga al final del body.
       Si no hay nada guardado no se toca nada y manda el sistema operativo. */
    (function () {
      try {
        if (document.documentElement.hasAttribute('data-tema-fijo')) return; // el admin fijo el modo
        var t = localStorage.getItem('tema');
        if (t === 'claro' || t === 'oscuro') document.documentElement.dataset.tema = t;
      } catch (e) { /* navegacion privada o cookies bloqueadas: da igual */ }
    })();
  </script>
</head>
<body class="<%= editando ? 'modo-edicion' : '' %><%= sinAnim ? ' sin-anim' : '' %><%= sinBotonTema ? ' sin-boton-tema' : '' %>">

<% if (editando) { %>
  <div class="ed-barra" id="edBarra">
    <span class="ed-marca">Editor</span>
    <button type="button" class="ed-btn ed-btn-2" id="edAnadir">＋ Sección</button>
    <button type="button" class="ed-btn ed-btn-2" id="edSecciones">☰ Secciones</button>
    <button type="button" class="ed-btn ed-btn-2" id="edProyectos">🗂 Proyectos</button>
    <button type="button" class="ed-btn ed-btn-2" id="edCabecera">▭ Cabecera</button>
    <button type="button" class="ed-btn ed-btn-2" id="edDiseno">🎨 Diseño</button>
    <span class="ed-estado" id="edEstado" role="status" aria-live="polite"></span>
    <button type="button" class="ed-btn ed-btn-2" id="edRestablecer">Restablecer todo</button>
    <a class="ed-btn ed-btn-2" href="/">Salir</a>
    <button type="button" class="ed-btn ed-btn-1" id="edGuardar">Guardar</button>
  </div>
<% } else if (esAdmin) { %>
  <a class="ed-pildora" href="/?editar=1">✏️ Editar la página</a>
<% } %>



<% if (cab.visible || editando) { %>
<header class="nav <%= cabEstilo.clase %><%= cab.visible ? '' : ' nav-oculta' %>" id="cabecera" style="<%= cabEstilo.style %>">
  <div class="shell nav-inner">
    <a class="brand" href="/">
      <% if (cab.logoTipo === 'texto') { %>
        <span class="brand-txt"><%= cab.logoTexto || site.name %></span>
      <% } else { %>
        <img class="brand-logo" src="<%= cab.logoSrc || '/img/logo-proshop.png' %>" alt="<%= site.name %>" />
      <% } %>
    </a>

    <nav class="nav-links" id="navLinks">
      <span style="display:contents" data-menu-box><% menu.forEach(function (m) { %><a href="<%= m.href || '#' + m.ancla %>"><%= m.texto %></a><% }); %></span>
      <button class="tema-movil" type="button" data-boton-tema>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
          <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" />
        </svg>
        <span data-tema-texto>Modo oscuro</span>
      </button>
    </nav>

    <div class="nav-actions">
      <button class="pildora tema" type="button" data-boton-tema aria-label="Cambiar de tema">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
          <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" />
        </svg>
      </button>
      <a class="btn btn-solid"<%- enlace('nav.cta', '#contacto') %> data-edit="nav.cta"><%- t('nav.cta', 'Solicitar diagnóstico') %></a>
      <button class="nav-toggle" id="navToggle" aria-label="Abrir menu" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
<% } %>

<main id="landingMain">
<% secciones.forEach(function (s) { %>
  <div class="seccion <%= s.clase %>" data-seccion="<%= s.id %>" data-tipo="<%= s.custom ? 'custom' : 'nativa' %>"<% if (s.anim) { %> data-anim="<%= s.anim %>"<% } %><% if (s.style) { %> style="<%= s.style %>"<% } %><% if (s.custom && s.ancla) { %> id="<%= s.ancla %>"<% } %>>
    <% if (s.custom) { %><%- s.html %><% } else { %><%- include('landing/' + s.id) %><% } %>
  </div>
<% }); %>
</main>

<% if (pie.visible || editando) { %>
<footer class="foot<%= pie.visible ? '' : ' nav-oculta' %>" id="pie" style="<%= pieEstilo.style %>">
  <div class="shell foot-inner">
    <div class="foot-brand">
      <img class="brand-logo" src="/img/logo-proshop.png" alt="<%= site.name %>" />
      <p data-edit="foot.desc"><%- t('foot.desc', 'Estrategia, marketing y tecnología para construir ventajas competitivas.') %></p>
    </div>

    <nav class="foot-nav">
      <span class="foot-lbl">ProShop</span>
      <span style="display:contents" data-menu-box><% menu.forEach(function (m) { %><a href="<%= m.href || '#' + m.ancla %>"><%= m.texto %></a><% }); %></span>
    </nav>

    <% if (pieSoluciones.length || editando) { %>
    <nav class="foot-nav" id="pieSoluciones">
      <span class="foot-lbl"><%= pie.solTitulo %></span>
      <% pieSoluciones.forEach(function (e) { %><a href="<%= e.href %>"<% if (/^https?:/i.test(e.href)) { %> target="_blank" rel="noopener"<% } %>><%= e.texto %></a><% }); %>
    </nav>
    <% } %>

    <div class="foot-end">
      <span data-edit="foot.copy"><%- t('foot.copy', '&copy; ' + new Date().getFullYear() + ' ' + site.name) %></span>
      <span data-edit="foot.lugar"><%- t('foot.lugar', site.location) %></span>
    </div>
  </div>
</footer>
<% } %>

<a class="fab-wa"<%- enlace('fab.wa', 'https://wa.me/' + site.whatsapp + '?text=' + encodeURIComponent('Hola ' + site.name + ', quiero conversar sobre mi proyecto.'), true) %> aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.95L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.1 15.08l-.3-.17-3.08.89.9-3-.2-.31A8.1 8.1 0 0 1 12.04 3.8Zm-3.2 4.1c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.2.87 2.35.99 2.51.12.16 1.7 2.7 4.19 3.68 2.07.82 2.5.66 2.95.62.45-.04 1.44-.59 1.65-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.95-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.74-1.8-.19-.46-.39-.4-.54-.41h-.46Z" /></svg>
</a>

<button class="pildora subir" id="btnSubir" type="button" aria-label="Volver arriba">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="1.7"
          stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script src="/js/landing.js"></script>
<% if (editando) { %>
<script id="edDatos" type="application/json"><%- edDatos %></script>
<script src="/js/bloques.js"></script>
<script src="/js/landing-cfg.js"></script>
<script src="/js/biblioteca.js"></script>
<script src="/js/landing-editor.js"></script>
<% } else if (hayCustom) { %>
<script src="/js/paginas-publico.js" data-origen="Landing" defer></script>
<% } %>
</body>
</html>

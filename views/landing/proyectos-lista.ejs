      <div class="proj">
        <!-- Lista de proyectos -->
        <div class="proj-tabs" role="tablist" aria-orientation="vertical" aria-label="Proyectos" data-tabs="panel">
          <% proyectos.forEach(function (p, i) { %>
            <button
              class="proj-tab <%= i === 0 ? 'is-active' : '' %> <%= p.oculto ? 'esta-oculto' : '' %>"
              role="tab"
              id="tab-<%= p.id %>"
              aria-controls="panel-<%= p.id %>"
              aria-selected="<%= i === 0 ? 'true' : 'false' %>"
              tabindex="<%= i === 0 ? '0' : '-1' %>"
              data-target="<%= p.id %>">
              <span class="proj-n"><%= String(i + 1).padStart(2, '0') %></span>
              <span class="proj-tab-body">
                <span class="proj-tab-name"><%= p.nombre %></span>
                <span class="proj-tab-type"><%= p.tipo %></span>
              </span>
              <span class="proj-arrow" aria-hidden="true">→</span>
            </button>
          <% }); %>
        </div>

        <!-- Paneles -->
        <div class="proj-panels">
          <% proyectos.forEach(function (p, i) { %>
            <article
              class="proj-panel <%= i === 0 ? 'is-active' : '' %> <%= p.oculto ? 'esta-oculto' : '' %>"
              role="tabpanel"
              id="panel-<%= p.id %>"
              aria-labelledby="tab-<%= p.id %>"
              data-proyecto="<%= p.id %>"
              tabindex="0"
              <%= i === 0 ? '' : 'hidden' %>>

              <% if (editando) { %>
                <div class="ed-proy">
                  <span class="ed-proy-id"><%= p.oculto ? 'Oculto: no se muestra en la web' : 'Proyecto ' + (i + 1) %></span>
                  <button type="button" class="ed-btn ed-btn-2" data-editar-proyecto="<%= p.id %>">✎ Editar este proyecto</button>
                </div>
              <% } %>

              <div class="pp-head">
                <div>
                  <h3 data-campo="nombre"><%= p.nombre %></h3>
                  <p class="pp-type">
                    <span data-campo="tipo"><%= p.tipo %></span><%
                      %><% if (p.lugar) { %> · <span data-campo="lugar"><%= p.lugar %></span><% } %>
                  </p>
                </div>
                <span class="pp-badges">
                  <span class="pp-origen"><%= p.origen === 'propio' ? 'Producto propio' : 'Proyecto para cliente' %></span>
                  <span class="pp-state pp-state-<%= p.estado %>">
                    <%= ({ produccion: 'En producción', desarrollo: 'En desarrollo', piloto: 'Piloto', demo: 'Demo' })[p.estado] || 'En desarrollo' %>
                  </span>
                </span>
              </div>

              <p class="pp-resumen" data-campo="resumen"><%= p.resumen %></p>

              <%# Contexto comercial: solo se muestra lo que tiene contenido (en el editor se ven todos para poder llenarlos) %>
              <% var ctx = [['problema', 'Problema inicial'], ['solucion', 'Solución implementada'], ['uso', 'Uso actual'], ['resultado', 'Resultado']]; %>
              <% if (ctx.some(function (c) { return p[c[0]]; }) || editando) { %>
                <dl class="pp-ctx">
                  <% ctx.forEach(function (c) { if (!p[c[0]] && !editando) return; %>
                    <div>
                      <dt><%= c[1] %></dt>
                      <dd data-campo="<%= c[0] %>" data-ph="Escribe aquí (opcional)"><%= p[c[0]] %></dd>
                    </div>
                  <% }); %>
                </dl>
              <% } %>

              <% if (p.imagen || p.boceto) { %>
                <% var paradas = p.puntos || []; %>
                <figure class="pp-boceto">
                  <% if (p.imagen) { %><div class="pp-chrome" aria-hidden="true"><i></i><i></i><i></i><span><%= p.nombre %></span></div><% } %>
                  <div class="visor"<% if (paradas.length) { %> data-recorrido<% } %>>
                    <% if (p.imagen) { %>
                      <img class="pp-shot"
                           src="<%= p.imagen %>"
                           alt="Captura de <%= p.nombre %>"
                           <% if (p.ancho && p.alto) { %>width="<%= p.ancho %>" height="<%= p.alto %>"<% } %>
                           loading="lazy" decoding="async" />
                    <% } else { %>
                      <%- include('partials/boceto', { id: p.id }) %>
                    <% } %>

                    <%# Las paradas se dibujan encima de la captura. Sin JS siguen
                        siendo botones inertes y la imagen se ve completa igual. %>
                    <% paradas.forEach(function (pt, k) { %>
                      <button type="button"
                              class="visor-punto"
                              style="--px: <%= pt.x %>%; --py: <%= pt.y %>%"
                              data-parada="<%= k %>"
                              data-texto="<%= pt.texto %>"
                              aria-label="Parada <%= k + 1 %> de <%= paradas.length %>: <%= pt.texto %>">
                        <span aria-hidden="true"><%= k + 1 %></span>
                      </button>
                    <% }); %>
                  </div>

                  <% if (paradas.length) { %>
                    <div class="visor-barra" hidden>
                      <button type="button" class="visor-nav" data-paso="-1" aria-label="Parada anterior">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
                      </button>
                      <span class="visor-pos" aria-hidden="true"></span>
                      <button type="button" class="visor-nav" data-paso="1" aria-label="Siguiente parada">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                      </button>
                      <button type="button" class="visor-salir" hidden>Ver completa</button>
                    </div>
                    <p class="visor-nota" role="status" aria-live="polite" hidden></p>
                  <% } %>

                  <% if (p.boceto) { %>
                    <figcaption data-campo="boceto"><%= p.boceto %></figcaption>
                  <% } %>
                </figure>
              <% } %>

              <% if (p.metricas && p.metricas.length) { %>
                <dl class="pp-metrics">
                  <% p.metricas.forEach(function (m) { %>
                    <div>
                      <dd><%= m.valor %></dd>
                      <dt><%= m.etiqueta %></dt>
                    </div>
                  <% }); %>
                </dl>
              <% } %>

              <div class="pp-cols">
                <div class="pp-col">
                  <h4>Qué hace</h4>
                  <ul class="pp-feats">
                    <% p.features.forEach(function (f) { %>
                      <li><%= f %></li>
                    <% }); %>
                  </ul>
                </div>
                <div class="pp-col">
                  <div class="pp-cta">
                    <h4 data-edit="cta.titulo"><%- t('cta.titulo', '¿Tienes un proceso parecido?') %></h4>
                    <p data-edit="cta.texto"><%- t('cta.texto', 'Conversemos en un diagnóstico sin costo para entender qué necesitas mejorar. Después definimos contigo el alcance y las etapas.') %></p>

                    <a class="btn btn-solid btn-block btn-wa"<%- enlace('proy.' + p.id + '.cta', 'https://wa.me/' + site.whatsapp + '?text=' + encodeURIComponent('Hola ' + site.name + ', vi ' + p.nombre + ' en su web y quiero solicitar un diagnóstico para mi empresa.'), true) %>>
                      <svg viewBox="0 0 24 24" aria-hidden="true" class="ico-wa">
                        <path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.95L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.1 15.08l-.3-.17-3.08.89.9-3-.2-.31A8.1 8.1 0 0 1 12.04 3.8Zm-3.2 4.1c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.2.87 2.35.99 2.51.12.16 1.7 2.7 4.19 3.68 2.07.82 2.5.66 2.95.62.45-.04 1.44-.59 1.65-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.95-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.74-1.8-.19-.46-.39-.4-.54-.41h-.46Z"/>
                      </svg>
                      <span data-edit="cta.boton"><%- t('cta.boton', 'Solicitar diagnóstico') %></span>
                    </a>

                    <% var enlaces = p.enlaces || []; %>
                    <% if (enlaces.length) { %>
                      <div class="pp-links">
                        <% enlaces.forEach(function (e, ei) { %>
                          <a class="btn btn-line <%= e.externo ? 'btn-ext' : '' %>"<%- enlace('proy.' + p.id + '.e' + ei, e.href, !!e.externo) %>>
                            <%= e.texto %>
                            <% if (e.externo) { %>
                              <svg viewBox="0 0 24 24" aria-hidden="true" class="ico-ext">
                                <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
                              </svg>
                            <% } %>
                          </a>
                        <% }); %>
                      </div>
                    <% } %>
                  </div>
                </div>
              </div>
            </article>
          <% }); %>
        </div>
      </div>

      <p class="proj-foot" data-edit="proj.pie">
        <%- t('proj.pie', '¿Y tu empresa? <a href="#contacto">Cuéntanos qué necesitas mejorar</a> y lo vemos en un diagnóstico, sin compromiso de precio ni de alcance.') %>
      </p>

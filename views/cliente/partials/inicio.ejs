<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin">
<div class="admin-shell">

  <aside class="sidebar" id="sidebar">
    <a href="/panel" class="sidebar-brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="30" height="30" fill="none">
          <rect x="2" y="2" width="28" height="28" rx="8" fill="url(#cb)" />
          <path d="M11 22V10h5.2c2.7 0 4.4 1.6 4.4 4s-1.7 4-4.4 4H14v4h-3zm3-6.6h2c1 0 1.6-.5 1.6-1.4s-.6-1.4-1.6-1.4h-2v2.8z" fill="#2fe3a6"/>
          <defs><linearGradient id="cb" x1="2" y1="2" x2="30" y2="30" gradientUnits="userSpaceOnUse"><stop stop-color="#9333ea"/><stop offset="1" stop-color="#6d28d9"/></linearGradient></defs>
        </svg>
      </span>
      <span class="sidebar-brand-stack">
        <span class="sidebar-brand-text"><%= site.name %></span>
        <strong class="sidebar-empresa"><%= empresaNombre %></strong>
      </span>
    </a>

    <nav class="sidebar-nav" aria-label="Menu de mi negocio">
      <span class="sidebar-section">Operación</span>
      <a href="/panel" class="<%= activo === 'inicio' ? 'is-active' : '' %>">
        <span class="si">🏠</span> Inicio
      </a>
      <a href="/panel/conversaciones" class="<%= activo === 'conversaciones' ? 'is-active' : '' %>">
        <span class="si">💬</span> Conversaciones
      </a>
      <a href="/panel/pedidos" class="<%= activo === 'pedidos' ? 'is-active' : '' %>">
        <span class="si">🛒</span> Pedidos
      </a>
      <a href="/panel/productos" class="<%= activo === 'productos' ? 'is-active' : '' %>">
        <span class="si">📦</span> Productos
      </a>
      <a href="/panel/clientes" class="<%= activo === 'clientes' ? 'is-active' : '' %>">
        <span class="si">👥</span> Clientes
      </a>
      <a href="/panel/inventario" class="<%= activo === 'inventario' ? 'is-active' : '' %>">
        <span class="si">📊</span> Inventario
      </a>
      <a href="/panel/agente" class="<%= activo === 'agente' ? 'is-active' : '' %>">
        <span class="si">🤖</span> Agente IA
      </a>
      <a href="/panel/whatsapp" class="<%= activo === 'whatsapp' ? 'is-active' : '' %>">
        <span class="si">📱</span> WhatsApp
      </a>
      <a href="/panel/reportes" class="<%= activo === 'reportes' ? 'is-active' : '' %>">
        <span class="si">📈</span> Reportes
      </a>
      <a href="/panel/configuracion" class="<%= activo === 'configuracion' ? 'is-active' : '' %>">
        <span class="si">⚙️</span> Configuración
      </a>

      <span class="sidebar-section">Plan y facturación</span>
      <a href="/panel/consumo" class="<%= activo === 'consumo' ? 'is-active' : '' %>">
        <span class="si">🎫</span> Mi consumo
      </a>
      <a href="/panel/paquetes" class="<%= activo === 'paquetes' ? 'is-active' : '' %>">
        <span class="si">➕</span> Comprar paquete
      </a>
      <a href="/panel/compras" class="<%= activo === 'compras' ? 'is-active' : '' %>">
        <span class="si">🧾</span> Mis compras
      </a>
    </nav>

    <div class="sidebar-foot">
      <a href="/" target="_blank" rel="noopener">Ver sitio ↗</a>
      <form method="POST" action="/panel/salir"><button type="submit">Cerrar sesión</button></form>
    </div>
  </aside>

  <div class="sidebar-overlay" id="sidebarOverlay" hidden></div>

  <div class="admin-body">
    <header class="admin-topbar">
      <button class="sidebar-toggle" id="sidebarToggle" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
      <h1 class="topbar-title"><%= tituloPagina %></h1>

      <div class="notif" id="notifWrap">
        <button class="notif-bell" id="notifBell" aria-label="Notificaciones">
          🔔
          <% if (typeof notifCount !== 'undefined' && notifCount > 0) { %>
            <span class="notif-dot"><%= notifCount %></span>
          <% } %>
        </button>
        <div class="notif-panel" id="notifPanel" hidden>
          <div class="notif-head">
            <strong>Notificaciones</strong>
            <% if (typeof notificaciones !== 'undefined' && notificaciones.length) { %>
              <form method="POST" action="/panel/notificaciones/leer-todas" class="inline-form">
                <button type="submit" class="notif-leer">Marcar todas leídas</button>
              </form>
            <% } %>
          </div>
          <div class="notif-list">
            <% if (typeof notificaciones === 'undefined' || notificaciones.length === 0) { %>
              <div class="notif-empty">No tienes notificaciones 🎉</div>
            <% } else { %>
              <% notificaciones.forEach(function (n) { %>
                <div class="notif-item <%= n.leida ? '' : 'is-unread' %>">
                  <div class="notif-item-top">
                    <strong><%= n.titulo %></strong>
                    <span class="notif-time"><%= new Date(n.createdAt).toLocaleDateString('es-BO') %></span>
                  </div>
                  <p><%= n.mensaje %></p>
                  <% if (n.conBotones) { %>
                    <div class="notif-actions">
                      <a class="btn btn-primary" href="/panel/paquetes">Comprar conversaciones</a>
                      <a class="btn btn-ghost" href="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent('Hola Proshop, quiero mejorar mi plan (' + empresaNombre + ')') %>" target="_blank" rel="noopener">Mejorar plan</a>
                    </div>
                  <% } %>
                  <% if (!n.leida) { %>
                    <form method="POST" action="/panel/notificaciones/<%= n.id %>/leida" class="inline-form">
                      <button type="submit" class="notif-marcar">Marcar como leída</button>
                    </form>
                  <% } %>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>
      </div>

      <span class="topbar-user">Hola, <strong><%= usuarioNombre %></strong></span>
    </header>

    <main class="admin-main">

  <!-- ============================================================
       HERO
  ============================================================= -->
  <section class="hero" id="inicio">
    <div class="shell">
      <div class="hero-main">
        <div class="hero-copy">
          <p class="tag">
            <span class="tag-dot" aria-hidden="true"></span>
            <span data-edit="hero.tag"><%- t('hero.tag', 'Estrategia · Tecnología · Competitividad') %></span>
          </p>

          <h1 class="hero-title" data-edit="hero.titulo">
            <%- t('hero.titulo', 'Entendemos tu negocio.<br />\n<em>Construimos lo que necesita</em>.') %>
          </h1>

          <% var rotCrudo = t('hero.rot', 'plataformas web|aplicaciones móviles|paneles de datos|agentes de IA|integraciones'); %>
          <p class="hero-rot">
            <span class="rot-lbl">Desarrollamos</span>
            <% if (editando) { %>
              <span class="rot-words" data-edit="hero.rot"><%- rotCrudo %></span>
            <% } else { %>
              <span class="rot-words" data-words="<%= rotCrudo %>"><span class="rot-w"><%= rotCrudo.split('|')[0] %></span></span>
            <% } %>
          </p>

          <p class="hero-lead" data-edit="hero.lead">
            <%- t('hero.lead', 'Trabajamos con empresas que ya operan y necesitan mejorar procesos concretos. Primero entendemos cómo funciona tu empresa; después diseñamos y desarrollamos <strong>plataformas web, aplicaciones móviles, paneles de control y agentes de inteligencia artificial</strong> a la medida de tus procesos.') %>
          </p>

          <div class="hero-cta">
            <a class="btn btn-solid btn-lg"<%- enlace('hero.cta1', '#contacto') %> data-edit="hero.cta1"><%- t('hero.cta1', 'Solicitar diagnóstico') %></a>
            <a class="btn btn-line btn-lg"<%- enlace('hero.cta2', '#proyectos') %> data-edit="hero.cta2"><%- t('hero.cta2', 'Ver proyectos') %></a>
            <p class="cta-note" data-edit="hero.nota"><%- t('hero.nota', 'La primera reunión es un diagnóstico de 20 minutos, sin costo.') %></p>
          </div>
        </div>

        <%- include('escena') %>
      </div>

      <dl class="specs">
        <div class="spec">
          <dt data-edit="spec1.et"><%- t('spec1.et', 'Cómo trabajamos') %></dt>
          <dd data-edit="spec1.valor"><%- t('spec1.valor', 'A medida') %></dd>
          <p data-edit="spec1.nota"><%- t('spec1.nota', 'Cada solución se diseña para tu negocio, partiendo de cómo opera hoy.') %></p>
        </div>
        <div class="spec">
          <dt data-edit="spec2.et"><%- t('spec2.et', 'Qué construimos') %></dt>
          <dd data-edit="spec2.valor"><%- t('spec2.valor', 'Web · Móvil · IA') %></dd>
          <p data-edit="spec2.nota"><%- t('spec2.nota', 'Desarrollo a medida. Adaptamos e integramos las herramientas que ya usas para acelerar la implementación.') %></p>
        </div>
        <div class="spec">
          <dt data-edit="spec3.et"><%- t('spec3.et', 'Dónde estamos') %></dt>
          <dd data-edit="spec3.valor"><%- t('spec3.valor', 'Bolivia y Perú') %></dd>
          <p data-edit="spec3.nota"><%- t('spec3.nota', 'Santa Cruz de la Sierra, Bolivia y Lima Metropolitana, Perú. Trabajamos con empresas que ya operan.') %></p>
        </div>
        <div class="spec">
          <dt data-edit="spec4.et"><%- t('spec4.et', 'Nuestro trabajo') %></dt>
          <dd data-edit="spec4.valor"><%- t('spec4.valor', 'En producción') %></dd>
          <p data-edit="spec4.nota"><%- t('spec4.nota', 'Sistemas y productos propios, con su estado real a la vista.') %></p>
        </div>
      </dl>
    </div>

    <%- include('integraciones') %>
  </section>

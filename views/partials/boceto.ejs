<%#
  Boceto (wireframe) de un proyecto. Recibe la variable "id".
  Lo incluye views/landing.ejs dentro de cada panel de proyecto.

  Son dibujos a linea, sin imagenes: no pesan nada, se ven nitidos en cualquier
  pantalla y toman los colores del tema desde las clases .bo-* de landing.css.
  Si agregas un proyecto y todavia no tiene boceto, no se rompe: no dibuja nada.

  OJO: no escribas una etiqueta EJS de cierre dentro de este comentario,
  lo corta a la mitad.
%>

<% if (id === 'protaxi') { %>
  <svg class="bo" viewBox="0 0 420 240" aria-hidden="true">
    <!-- aviso flotante -->
    <rect x="24" y="52" width="96" height="52" rx="8" class="bo-s bo-pf" />
    <circle cx="42" cy="70" r="6" class="bo-a" />
    <rect x="56" y="66" width="48" height="6" rx="3" class="bo-f" />
    <rect x="38" y="84" width="66" height="4" rx="2" class="bo-f2" />
    <path d="M126 66 q10 12 0 24" class="bo-a" />
    <path d="M134 60 q16 18 0 36" class="bo-s2" />

    <!-- telefono -->
    <rect x="152" y="10" width="140" height="220" rx="18" class="bo-s bo-pf" />
    <rect x="205" y="20" width="34" height="5" rx="2.5" class="bo-f2" />
    <line x1="152" y1="40" x2="292" y2="40" class="bo-s2" />
    <text x="166" y="60" class="bo-t">VIAJE NUEVO</text>

    <!-- tarjeta de oferta -->
    <rect x="164" y="70" width="116" height="106" rx="8" class="bo-a bo-abg" />
    <text x="176" y="94" class="bo-tb">Bs 25</text>
    <circle cx="180" cy="112" r="3.5" class="bo-af" />
    <line x1="180" y1="116" x2="180" y2="134" class="bo-s2" />
    <rect x="177" y="134" width="7" height="7" class="bo-af" />
    <rect x="192" y="108" width="72" height="5" rx="2.5" class="bo-f2" />
    <rect x="192" y="133" width="56" height="5" rx="2.5" class="bo-f2" />
    <rect x="176" y="152" width="48" height="16" rx="8" class="bo-af" />
    <rect x="230" y="152" width="38" height="16" rx="8" class="bo-s2" />

    <!-- barra inferior -->
    <line x1="152" y1="192" x2="292" y2="192" class="bo-s2" />
    <circle cx="182" cy="210" r="5" class="bo-af" />
    <circle cx="222" cy="210" r="5" class="bo-s2" />
    <circle cx="262" cy="210" r="5" class="bo-s2" />

    <!-- ganancias -->

  <!-- ============================================================
       04 — CONTACTO
  ============================================================= -->
  <section id="contacto" class="section section-tint">
    <div class="shell">
      <header class="head">
        <span class="idx">04</span>
        <h2 data-edit="sec5.titulo"><%- t('sec5.titulo', 'Conversemos sobre tu empresa.') %></h2>
        <p data-edit="sec5.lead"><%- t('sec5.lead', 'Cuentanos como funciona tu negocio, que necesitas mejorar y que resultado esperas. Te ayudaremos a encontrar la solucion adecuada.') %></p>
      </header>

      <div class="contact">
        <div class="contact-side">
          <div class="chat-card" aria-hidden="true">
            <div class="cc-head"><span class="cc-av"></span><span><strong data-edit="contacto.chat.nombre"><%- t('contacto.chat.nombre', 'ProShop') %></strong><small><i></i> <span data-edit="contacto.chat.estado"><%- t('contacto.chat.estado', 'en línea') %></span></small></span></div>
            <div class="cc-body">
              <p class="u1" data-edit="contacto.chat.m1"><%- t('contacto.chat.m1', 'Hola, quiero una plataforma para mi empresa') %></p>
              <p class="b1" data-edit="contacto.chat.m2"><%- t('contacto.chat.m2', '¡Hola! Cuéntame cómo trabajas hoy y qué quieres mejorar.') %></p>
              <p class="u2" data-edit="contacto.chat.m3"><%- t('contacto.chat.m3', 'Vendemos por WhatsApp y todo es manual') %></p>
              <p class="b2" data-edit="contacto.chat.m4"><%- t('contacto.chat.m4', 'Perfecto, lo automatizamos. Agendemos 20 min 👍') %></p>
              <span class="typing"><i></i><i></i><i></i></span>
            </div>
          </div>
          <ul class="contact-list">
            <li>
              <span class="cl-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 12a8.5 8.5 0 0 1-12.4 7.5L3 21l1.6-5.4A8.5 8.5 0 1 1 21 12z"/><path d="M9 9.5c.3 2.2 2.3 4.2 5 5l1.3-1.3-1.8-1-1 .6a4 4 0 0 1-1.8-1.8l.6-1-1-1.8z"/></svg></span>
              <div><span class="cl-lbl" data-edit="contacto.wa.et"><%- t('contacto.wa.et', 'WhatsApp') %></span>
              <a<%- enlace('contacto.wa', 'https://wa.me/' + site.whatsapp, true) %> data-edit="contacto.wa.valor"><%- t('contacto.wa.valor', site.phone) %></a></div>
            </li>
            <li>
              <span class="cl-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/></svg></span>
              <div><span class="cl-lbl" data-edit="contacto.mail.et"><%- t('contacto.mail.et', 'Correo') %></span>
              <a<%- enlace('contacto.mail', 'mailto:' + site.email) %> data-edit="contacto.mail.valor"><%- t('contacto.mail.valor', site.email) %></a></div>
            </li>
            <li>
              <span class="cl-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
              <div><span class="cl-lbl" data-edit="contacto.lugar.et"><%- t('contacto.lugar.et', 'Donde estamos') %></span>
              <span data-edit="contacto.lugar.valor"><%- t('contacto.lugar.valor', site.location) %></span></div>
            </li>
          </ul>
          <p class="contact-note" data-edit="contacto.nota">
            <%- t('contacto.nota', 'Respondemos en horario de oficina. Para una atencion mas rapida, escribinos por WhatsApp.') %>
          </p>
        </div>

        <form class="form" id="contactForm" novalidate>
          <div class="field">
            <label for="nombre"><span data-edit="form.nombre"><%- t('form.nombre', 'Nombre') %></span> <i>*</i></label>
            <input id="nombre" name="nombre" type="text" required autocomplete="name" placeholder="¿Como te llamas?" />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email"><span data-edit="form.correo"><%- t('form.correo', 'Correo') %></span> <i>*</i></label>
              <input id="email" name="email" type="email" required autocomplete="email" placeholder="tu@correo.com" />
            </div>
            <div class="field">
              <label for="telefono"><span data-edit="form.telefono"><%- t('form.telefono', 'WhatsApp') %></span></label>
              <input id="telefono" name="telefono" type="tel" autocomplete="tel" placeholder="+591 7xx xxx" />
            </div>
          </div>

          <div class="field">
            <label for="servicio"><span data-edit="form.servicio"><%- t('form.servicio', '¿Que necesitas mejorar?') %></span></label>
            <select id="servicio" name="servicio">
              <option value="">Necesito orientacion</option>
              <option>Automatizar procesos</option>
              <option>Mejorar ventas o atencion</option>
              <option>Desarrollar una plataforma web</option>
              <option>Crear una aplicacion movil</option>
              <option>Implementar inteligencia artificial</option>
              <option>Integrar sistemas y herramientas</option>
              <option>Retomar un proyecto detenido</option>
              <option>Otro desafio</option>
            </select>
          </div>

          <div class="field">
            <label for="mensaje"><span data-edit="form.mensaje"><%- t('form.mensaje', 'Cuentanos tu desafio') %></span> <i>*</i></label>
            <textarea id="mensaje" name="mensaje" rows="4" required placeholder="¿Como funciona tu empresa y que proceso, problema u oportunidad te gustaria mejorar?"></textarea>
          </div>

          <%# En el editor el boton es un div: el navegador no deja escribir dentro de un <button>. %>
          <% if (editando) { %>
            <div class="btn btn-solid btn-lg btn-block" id="submitBtn"><span data-edit="form.boton"><%- t('form.boton', 'Conversemos') %></span></div>
          <% } else { %>
            <button type="submit" class="btn btn-solid btn-lg btn-block" id="submitBtn"><span data-edit="form.boton"><%- t('form.boton', 'Conversemos') %></span></button>
          <% } %>
          <p class="form-note" id="formNote" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

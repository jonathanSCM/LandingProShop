# Copia este archivo a ".env" y ajusta los valores.
PORT=3000

# Numero de WhatsApp en formato internacional SIN el signo "+"
# Bolivia = 591 + numero de 8 digitos. Ej: 59162095357
WHATSAPP_NUMBER=59162095357

CONTACT_EMAIL=soporte@proshop.lat
CONTACT_PHONE=+591 62095357
CONTACT_LOCATION=Santa Cruz de la Sierra, Bolivia | Lima Metropolitana, Perú

# Enlace opcional "Agentes de IA" del pie de la landing. Déjalo vacío para ocultarlo.
PLATFORM_URL=https://agentes.proshop.lat

# ----- Panel de administracion (/admin) -----
# CAMBIA estas credenciales por unas propias antes de publicar el sitio.
ADMIN_USER=admin
ADMIN_PASSWORD=proshop123
# Secreto para firmar la sesion (usa una cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-secreta

# Base de datos PostgreSQL (guarda páginas, imágenes y textos editados)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/proshop

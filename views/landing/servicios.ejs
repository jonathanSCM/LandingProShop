  <!-- ============================================================
       01 — QUE HACEMOS
  ============================================================= -->
  <section id="servicios" class="section section-tint">
    <div class="shell">
      <header class="head">
        <span class="idx">01</span>
        <h2 data-edit="sec1.titulo"><%- t('sec1.titulo', 'Cada desafío necesita una solución diferente.') %></h2>
        <p data-edit="sec1.lead"><%- t('sec1.lead', 'Estas son algunas situaciones que reconocemos en empresas que ya operan y algunas formas que puede tomar la solución. Si tu desafío es distinto, lo vemos contigo.') %></p>
      </header>

      <div class="prob">
        <h3 class="sub-t" data-edit="prob.titulo"><%- t('prob.titulo', '¿Cuál de estas situaciones reconoces?') %></h3>
        <div class="prob-grid">
          <article class="prob-card">
            <span class="prob-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5v8l9 5 9-5zM3 8l9 5 9-5M12 13v8" /></svg></span>
            <h4 data-edit="prob1.titulo"><%- t('prob1.titulo', 'Pedidos y stock') %></h4>
            <p data-edit="prob1.texto"><%- t('prob1.texto', 'Pedidos por WhatsApp, diferencias de inventario y falta de control de entregas.') %></p>
            <a class="prob-link"<%- enlace('prob1.ver', 'https://agentes.proshop.lat', true) %> data-edit="prob1.link"><%- t('prob1.link', 'Ver el agente de ventas por WhatsApp →') %></a>
          </article>
          <article class="prob-card">
            <span class="prob-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4M8 14h3" /></svg></span>
            <h4 data-edit="prob2.titulo"><%- t('prob2.titulo', 'Servicios con agenda') %></h4>
            <p data-edit="prob2.texto"><%- t('prob2.texto', 'Citas dispersas, confirmaciones manuales y poco seguimiento de clientes.') %></p>
            <a class="prob-link" href="#proyectos" data-ver-proyecto="agendabot" data-edit="prob2.link"><%- t('prob2.link', 'Ver el ejemplo: AgendaBot →') %></a>
          </article>
          <article class="prob-card">
            <span class="prob-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 20V9l6 4V9l6 4V6h3v14zM7 20v-3M12 20v-3M17 20v-3" /></svg></span>
            <h4 data-edit="prob3.titulo"><%- t('prob3.titulo', 'Producción por pedido') %></h4>
            <p data-edit="prob3.texto"><%- t('prob3.texto', 'Cotizaciones, responsables, avances y fechas de entrega difíciles de controlar.') %></p>
            <a class="prob-link" href="#proyectos" data-ver-proyecto="santa-isabel" data-edit="prob3.link"><%- t('prob3.link', 'Ver el ejemplo: Santa Isabel →') %></a>
          </article>
        </div>
        <h3 class="sub-t sub-t-2" data-edit="prob.titulo2"><%- t('prob.titulo2', 'Y estas son las formas que puede tomar la solución') %></h3>
      </div>

      <div class="feats">
        <article class="feat">
          <div class="feat-art" aria-hidden="true"><%- include('arte/web') %></div>
          <span class="feat-n" aria-hidden="true">A</span>
          <h3 data-edit="feat1.titulo"><%- t('feat1.titulo', 'Plataformas web') %></h3>
          <p data-edit="feat1.texto"><%- t('feat1.texto', 'Sistemas web que organizan procesos, conectan equipos y se adaptan a la forma real de operar de tu empresa.') %></p>
        </article>
        <article class="feat">
          <div class="feat-art" aria-hidden="true"><%- include('arte/movil') %></div>
          <span class="feat-n" aria-hidden="true">B</span>
          <h3 data-edit="feat2.titulo"><%- t('feat2.titulo', 'Aplicaciones móviles') %></h3>
          <p data-edit="feat2.texto"><%- t('feat2.texto', 'Aplicaciones para Android y iOS conectadas con tus procesos, usuarios y objetivos de negocio.') %></p>
        </article>
        <article class="feat">
          <div class="feat-art" aria-hidden="true"><%- include('arte/datos') %></div>
          <span class="feat-n" aria-hidden="true">C</span>
          <h3 data-edit="feat3.titulo"><%- t('feat3.titulo', 'Control y decisiones') %></h3>
          <p data-edit="feat3.texto"><%- t('feat3.texto', 'Controla usuarios, ventas, inventario y reportes con información clara para decidir mejor.') %></p>
        </article>
        <article class="feat feat-hi">
          <div class="feat-art" aria-hidden="true"><%- include('arte/ia') %></div>
          <span class="feat-n" aria-hidden="true">D</span>
          <h3 data-edit="feat4.titulo"><%- t('feat4.titulo', 'Agentes con IA') %></h3>
          <p data-edit="feat4.texto"><%- t('feat4.texto', 'Agentes entrenados con tu negocio para atender, vender y automatizar procesos con propósito.') %></p>
          <span class="feat-tag" data-edit="feat4.tag"><%- t('feat4.tag', 'Meta Tech Provider · WhatsApp Business Platform') %></span>
        </article>
        <article class="feat">
          <div class="feat-art" aria-hidden="true"><%- include('arte/conexion') %></div>
          <span class="feat-n" aria-hidden="true">E</span>
          <h3 data-edit="feat5.titulo"><%- t('feat5.titulo', 'Procesos conectados') %></h3>
          <p data-edit="feat5.texto"><%- t('feat5.texto', 'Conectamos tus sistemas para reducir tareas manuales y mantener la información sincronizada.') %></p>
        </article>
        <article class="feat">
          <div class="feat-art" aria-hidden="true"><%- include('arte/avance') %></div>
          <span class="feat-n" aria-hidden="true">F</span>
          <h3 data-edit="feat6.titulo"><%- t('feat6.titulo', 'Proyectos en marcha') %></h3>
          <p data-edit="feat6.texto"><%- t('feat6.texto', '¿Tienes un proyecto detenido o difícil de mantener? Lo recuperamos, mejoramos y llevamos a producción.') %></p>
        </article>
      </div>
    </div>
  </section>
